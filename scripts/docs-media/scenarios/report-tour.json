    {"do": "eval", "frame": true, "js": "document.querySelector('.hero-line .tip').classList.remove('open')", "ms": 200},
    {"do": "hover", "sel": "report: .ov-start", "ms": 900},
    {"do": "click", "sel": "report: a.hero-crit", "ms": 1500},
    {"do": "click", "sel": "report: details.group[data-rule=\"PW-006\"] > summary", "ms": 1000},
    {"do": "click", "sel": "report: #f-PW-006-1ba3d75126b2c612 > summary", "ms": 700},
    {"do": "scroll", "sel": "report: #f-PW-006-1ba3d75126b2c612 svg.pathviz", "block": "center", "ms": 2400}
  ]
